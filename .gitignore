# ============================================================
# MediMind AI — .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo
*.pyd

# ── Virtual Environments ────────────────────────────────────
.venv/
venv/
ENV/
env/
.env.bak

# ── Environment & Secrets ───────────────────────────────────
# Never commit real secrets — use .env.example as template
backend/.env
.env
*.env
!backend/.env.example
!.env.example

# ── Database Files ──────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/healthcare.db

# ── ChromaDB Local Data ─────────────────────────────────────
backend/chroma_data/

# ── ML Model Artifacts ──────────────────────────────────────
ml-training/model_artifacts/*.joblib
ml-training/model_artifacts/*.pkl
ml-training/model_artifacts/*.h5
ml-training/model_artifacts/*.pt

# ── Node.js ─────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.swc/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ── Next.js Build ───────────────────────────────────────────
.next/
out/
build/

# ── Testing & Coverage ──────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
coverage.xml
*.cover
.hypothesis/
.tox/
nosetests.xml

# ── IDEs & Editors ──────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*.orig
.DS_Store
Thumbs.db

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── Docker ──────────────────────────────────────────────────
docker-compose.override.yml

# ── Misc ────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
*.bak
*.tmp
