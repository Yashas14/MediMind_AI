# Healthcare AI Platform — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control.
# ============================================================

# ── App ─────────────────────────────────────────────────────
APP_NAME=Healthcare AI Platform
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── Server ──────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Database ─────────────────────────────────────────────────
# Local development (SQLite — no PostgreSQL needed):
DATABASE_URL=sqlite+aiosqlite:///./healthcare.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/healthcare_db
POSTGRES_USER=healthcare_user
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=healthcare_db

# ── JWT / Auth ───────────────────────────────────────────────
# IMPORTANT: Change this to a long random string before deploying!
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-A-LONG-RANDOM-STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Anthropic Claude (required for AI features) ─────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# ── ChromaDB (vector store) ──────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=medical_knowledge

# ── Redis (optional — for caching in production) ─────────────
REDIS_URL=redis://localhost:6379/0

# ── External APIs (optional) ─────────────────────────────────
# Google Maps — required for nearby hospital search
GOOGLE_MAPS_API_KEY=your-google-maps-key-here

# OpenFDA — enhanced drug information (works without a key too)
OPENFDA_API_KEY=your-openfda-key-here

# ── Notifications (optional) ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@healthcareai.com

# ── Monitoring (optional) ────────────────────────────────────
SENTRY_DSN=

# ── Encryption ───────────────────────────────────────────────
# Must be exactly 32 bytes for AES-256
ENCRYPTION_KEY=CHANGE-ME-32-BYTE-KEY-1234567890
